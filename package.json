{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -C packages/cli build",
    "test": "pnpm -C packages/cli test",
    "lint": "pnpm -C packages/cli lint",
    "typecheck": "pnpm -C packages/cli typecheck",
    "release": "pnpm -C packages/cli release",
    "release:minor": "pnpm -C packages/cli release:minor",
    "release:major": "pnpm -C packages/cli release:major",
    "release:beta": "pnpm -C packages/cli release:beta",
    "release:rc": "pnpm -C packages/cli release:rc",
    "release:promote": "pnpm -C packages/cli release:promote",
    "release:check": "node packages/cli/scripts/release-preflight.js check-versions",
    "release:plan": "node packages/cli/scripts/release-preflight.js publish-plan"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
